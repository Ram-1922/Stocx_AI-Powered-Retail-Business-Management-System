# ==========================================
# Stocx Dynamic Uploads & Generated Images
# ==========================================
# Ignore all dynamically generated billing receipts and user store logos
static/uploads/receipts/*
static/logos/*

# Exceptions: Allow git to track the directories themselves via empty files if used
!static/uploads/receipts/.gitkeep
!static/logos/.gitkeep

